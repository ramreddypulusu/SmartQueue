// PROFILE DETAIL PAGES
class InfoPage extends StatelessWidget {
  final String title;
  const InfoPage({super.key, required this.title});

  String get description {
    switch (title) {
      case 'My Details':
        return 'View your SmartQueue profile information. Personal details can be added in a future version.';
      case 'About SmartQueue':
        return 'SmartQueue is a digital queue booking application. It helps users select services and generate tokens.';
      case 'Help & Support':
        return 'For assistance, check your booking details and token number. Contact the service provider for actual queue updates.';
      case 'Contact Us':
        return 'SmartQueue Support\nEmail: support@example.com\nPhone: Contact your service provider.';
      default:
        return 'Your booking details should be handled securely. Do not enter passwords, bank PINs or sensitive identity information in this demo.';
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(title)),
      body: Padding(
        padding: const EdgeInsets.all(22),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Icon(
              title == 'My Details' ? Icons.person :
              title == 'About SmartQueue' ? Icons.info :
              title == 'Help & Support' ? Icons.help :
              title == 'Contact Us' ? Icons.contact_support :
              Icons.privacy_tip,
              size: 55,
              color: Colors.blue,
            ),
            const SizedBox(height: 20),
            Text(title, style: const TextStyle(
                fontSize: 23, fontWeight: FontWeight.bold)),
            const SizedBox(height: 12),
            Text(description, style: const TextStyle(fontSize: 17)),
          ],
        ),
      ),
    );
  }
}
