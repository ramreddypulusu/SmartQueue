class Booking {
  final String name;
  final String category;
  final String service;
  final int token;

  Booking(this.name, this.category, this.service, this.token);
}

class MainScreen extends StatefulWidget {
  const MainScreen({super.key});

  @override
  State<MainScreen> createState() => _MainScreenState();
}

class _MainScreenState extends State<MainScreen> {
  int selectedTab = 0;
  int nextToken = 101;
  Booking? booking;

  void showPage(Widget page) {
    Navigator.push(
      context,
      MaterialPageRoute(builder: (_) => page),
    );
  }

  Future<void> startBooking(String category, String service) async {
    if (booking != null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Cancel your current booking first.')),
      );
      return;
    }

    final result = await Navigator.push<Booking>(
      context,
      MaterialPageRoute(
        builder: (_) => BookingPage(
          category: category,
          service: service,
          token: nextToken,
        ),
      ),
    );

    if (result != null && mounted) {
      setState(() {
        booking = result;
        nextToken++;
        selectedTab = 2;
      });
      showPage(ConfirmationPage(booking: result));
    }
  }

  @override
  Widget build(BuildContext context) {
    final pages = [
      HomePage(onSelect: (category) {
        setState(() => selectedTab = 1);
      }),
      ServicesPage(onSelect: (category, service) {
        startBooking(category, service);
      }),
      QueuePage(
        booking: booking,
        onCancel: () => setState(() => booking = null),
      ),
      ProfilePage(onOpen: showPage),
    ];

    return Scaffold(
      body: SafeArea(child: pages[selectedTab]),
      bottomNavigationBar: NavigationBar(
        selectedIndex: selectedTab,
        onDestinationSelected: (index) {
          setState(() => selectedTab = index);
        },
        destinations: const [
          NavigationDestination(icon: Icon(Icons.home), label: 'Home'),
          NavigationDestination(icon: Icon(Icons.apps), label: 'Services'),
          NavigationDestination(icon: Icon(Icons.confirmation_number),
              label: 'My Queue'),
          NavigationDestination(icon: Icon(Icons.person), label: 'Profile'),
        ],
      ),
    );
  }
}

