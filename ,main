// MY QUEUE SCREEN
class QueuePage extends StatelessWidget {
  final Booking? booking;
  final VoidCallback onCancel;

  const QueuePage({
    super.key,
    required this.booking,
    required this.onCancel,
  });

  @override
  Widget build(BuildContext context) {
    if (booking == null) {
      return const Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(Icons.queue, size: 75, color: Colors.grey),
            SizedBox(height: 12),
            Text('No Active Booking',
                style: TextStyle(fontSize: 22,
                    fontWeight: FontWeight.bold)),
            Text('Book a service to view your token here.'),
          ],
        ),
      );
    }

    return Padding(
      padding: const EdgeInsets.all(20),
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const Icon(Icons.confirmation_number,
              size: 65, color: Colors.blue),
          const Text('Your Queue Details',
              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold)),
          const SizedBox(height: 20),
          Text('Token: ${booking!.token}',
              style: const TextStyle(fontSize: 28, color: Colors.blue)),
          Text('Name: ${booking!.name}'),
          Text('Category: ${booking!.category}'),
          Text('Service: ${booking!.service}'),
          const SizedBox(height: 15),
          const Text('Waiting time: Awaiting queue information'),
          const SizedBox(height: 25),
          ElevatedButton.icon(
            onPressed: () => showDialog(
              context: context,
              builder: (dialogContext) => AlertDialog(
                title: const Text('Cancel Booking?'),
                content: const Text('Do you want to cancel this booking?'),
                actions: [
                  TextButton(
                    onPressed: () => Navigator.pop(dialogContext),
                    child: const Text('No'),
                  ),
                  TextButton(
                    onPressed: () {
                      onCancel();
                      Navigator.pop(dialogContext);
                    },
                    child: const Text('Yes, Cancel'),
                  ),
                ],
              ),
            ),
            icon: const Icon(Icons.cancel),
            label: const Text('Cancel Booking'),
            style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red,
                foregroundColor: Colors.white),
          ),
        ],
      ),
    );
  }
}

